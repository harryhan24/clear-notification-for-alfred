				<key>applescript</key>
				<string>-- 화면에 떠 있는 알림(배너 스택)을 전부 닫는다.
-- NotificationCenter 프로세스의 배너 그룹이 노출하는 "Name:Clear All" / "Name:Close"
-- 액션을 직접 perform 한다. 묶인 알림은 Clear All 이 한 번에 처리하므로 우선 시도.
on alfred_script(q)
	set cleared to 0
	repeat 20 times
		set didClear to false
		try
			tell application "System Events"
				tell process "NotificationCenter"
					if (exists window "Notification Center") then
						set sa to scroll area 1 of group 1 of group 1 of window "Notification Center"
						set els to UI elements of sa
						if (count of els) &gt; 0 then
							set acts to actions of (item 1 of els)
							repeat with a in acts
								if (name of a) starts with "Name:Clear All" then
									perform a
									set didClear to true
									exit repeat
								end if
							end repeat
							if not didClear then
								repeat with a in acts
									if (name of a) starts with "Name:Close" then
										perform a
										set didClear to true
										exit repeat
									end if
								end repeat
							end if
						end if
					end if
				end tell
			end tell
		on error
			-- 알림이 지워지는 중이면 UI 참조가 사라져 에러가 난다. 정상 종료로 취급.
			set didClear to false
		end try
		if not didClear then exit repeat
		set cleared to cleared + 1
		delay 0.15
	end repeat
	return cleared
end alfred_script
</string>
